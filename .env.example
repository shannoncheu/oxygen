# Production: `bash scripts/deploy.sh` generates this file with a random secret.
# Use a domain only: no https:// prefix, path, port or trailing slash.
DOMAIN=subscriptions.example.com
# Host-installed Nginx: `bash scripts/deploy.sh --nginx` adds this automatically.
# COMPOSE_FILE=compose.nginx.yaml
# Replace with 64 lowercase hexadecimal characters; never use this placeholder.
# `openssl rand -hex 32` generates a URL-safe PostgreSQL password.
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Local development only (copy these to .env.local, not production .env):
# APP_URL=http://localhost:3000
# PGLITE_DATA_DIR=./data/dev-db
# UPLOAD_DIR=./data/uploads
# Alternatively use a local PostgreSQL database:
# DATABASE_URL=postgresql://renew:YOUR_URL_ENCODED_PASSWORD@localhost:5432/renew

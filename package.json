    "@radix-ui/react-dialog": "1.1.23",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prettier": "3.9.6",
    "simple-icons": "16.29.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }

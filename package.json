{
  "name": "renew-private",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "admin": "tsx scripts/admin.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib scripts e2e tests *.ts *.json"
  },
  "dependencies": {
    "@dicebear/core": "9.4.2",
    "@dicebear/thumbs": "9.4.2",
    "@next/env": "16.3.4",
